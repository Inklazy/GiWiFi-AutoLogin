<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 1. 顶部 Header 与 品牌区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GiWiFi 认证助手"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="校园网一键登录与网络保持工具"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

            <!-- M3 状态 Pill Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="18dp"
                android:paddingTop="7dp"
                android:paddingEnd="18dp"
                android:paddingBottom="7dp"
                android:text="未检测网络"
                android:textColor="@color/status_neutral_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 2. 凭据配置 M3 Surface Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号配置"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上网账号 / 手机号"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/etAccount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:hint="请输入手机号或上网账号"
                android:textColorHint="@color/md_theme_light_outline"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上网密码"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_input_field"
                android:hint="请输入上网密码"
                android:textColorHint="@color/md_theme_light_outline"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <!-- M3 Filled Primary Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary_m3"
                android:text="保存并一键认证"
                android:textColor="@color/md_theme_light_onPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null" />

            <!-- 次要操作按钮栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCheck"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_tonal_m3"
                    android:text="仅测试网络"
                    android:textColor="@color/md_theme_light_onSecondaryContainer"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_outlined_m3"
                    android:text="清除保存信息"
                    android:textColor="@color/md_theme_light_outline"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. 运行日志与控制台 Terminal Surface -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_console_terminal"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运行状态与控制台日志"
                    android:textColor="@color/terminal_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="清屏"
                    android:textColor="@color/terminal_accent"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text=""
                    android:textColor="@color/terminal_text"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
